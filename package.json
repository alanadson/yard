{
  "name": "yard",
  "private": true,
  "version": "0.1.0",
  "description": "Agent orchestrator for Windows — run Claude Code, Codex, OpenCode and shells side by side in real terminals, organized in projects, groups and an infinite canvas.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alanadson/yard.git"
  },
  "homepage": "https://github.com/alanadson/yard#readme",
  "bugs": {
    "url": "https://github.com/alanadson/yard/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "tauri": "tauri",
    "app": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/yard.ps1",
    "app:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/yard.ps1 -Release",
    "app:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/yard.ps1 -Installer",
    "app:shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/yard.ps1 -Shortcut"
  },
